<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Encabezado: plano, sin degradado -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/titulo_app"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitulo_app"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/svMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Formulario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvFormTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/titulo_nuevo"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    style="@style/InvLabel"
                    android:text="@string/hint_nombre" />

                <EditText
                    android:id="@+id/etNombre"
                    style="@style/InvInput"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/placeholder_nombre"
                    android:inputType="textPersonName|textCapSentences" />

                <TextView
                    style="@style/InvLabel"
                    android:text="@string/hint_descripcion" />

                <EditText
                    android:id="@+id/etDescripcion"
                    style="@style/InvInput"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/placeholder_descripcion"
                    android:inputType="text|textCapSentences" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/InvLabel"
                            android:text="@string/hint_cantidad" />

                        <EditText
                            android:id="@+id/etCantidad"
                            style="@style/InvInput"
                            android:hint="@string/placeholder_cantidad"
                            android:inputType="number" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/InvLabel"
                            android:text="@string/label_precio" />

                        <EditText
                            android:id="@+id/etPrecio"
                            style="@style/InvInput"
                            android:hint="@string/placeholder_precio"
                            android:inputType="numberDecimal" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/InvLabel"
                    android:text="@string/hint_proveedor" />

                <EditText
                    android:id="@+id/etProveedor"
                    style="@style/InvInput"
                    android:layout_marginBottom="18dp"
                    android:hint="@string/placeholder_proveedor"
                    android:inputType="text|textCapWords" />

                <Button
                    android:id="@+id/btnCrear"
                    style="@style/InvButton.Primary"
                    android:layout_width="match_parent"
                    android:text="@string/btn_crear" />

                <!-- Solo tiene sentido con un producto seleccionado -->
                <LinearLayout
                    android:id="@+id/filaAcciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnActualizar"
                        style="@style/InvButton.Outline"
                        android:layout_width="0dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_actualizar" />

                    <Button
                        android:id="@+id/btnEliminar"
                        style="@style/InvButton.Danger"
                        android:layout_width="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_eliminar" />
                </LinearLayout>
            </LinearLayout>

            <!-- Inventario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/label_inventario"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvContador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etBuscar"
                style="@style/InvInput"
                android:layout_marginBottom="10dp"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint="@string/hint_buscar"
                android:inputType="text" />

            <!-- Filtro por rango de precio -->
            <TextView
                style="@style/InvLabel"
                android:text="Filtrar por rango de precio" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPrecioMin"
                    style="@style/InvInput"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="Precio mín."
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/etPrecioMax"
                    style="@style/InvInput"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="Precio máx."
                    android:inputType="numberDecimal" />

                <Button
                    android:id="@+id/btnLimpiarFiltro"
                    style="@style/InvButton.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Limpiar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerInventario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInventario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_cargando"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>