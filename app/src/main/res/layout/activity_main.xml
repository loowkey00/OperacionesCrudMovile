<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Encabezado -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_app"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitulo_app"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/svMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tarjeta del formulario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvFormTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/titulo_nuevo"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Nombre -->
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/hint_nombre" />

                <EditText
                    android:id="@+id/etNombre"
                    style="@style/FormInput"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/placeholder_nombre"
                    android:inputType="textPersonName|textCapSentences" />

                <!-- Descripción -->
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/hint_descripcion" />

                <EditText
                    android:id="@+id/etDescripcion"
                    style="@style/FormInput"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/placeholder_descripcion"
                    android:inputType="text|textCapSentences" />

                <!-- Cantidad y precio en la misma fila -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FormLabel"
                            android:text="@string/hint_cantidad" />

                        <EditText
                            android:id="@+id/etCantidad"
                            style="@style/FormInput"
                            android:hint="@string/placeholder_cantidad"
                            android:inputType="number" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FormLabel"
                            android:text="@string/label_precio" />

                        <EditText
                            android:id="@+id/etPrecio"
                            style="@style/FormInput"
                            android:hint="@string/placeholder_precio"
                            android:inputType="numberDecimal" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Proveedor -->
                <TextView
                    style="@style/FormLabel"
                    android:text="@string/hint_proveedor" />

                <EditText
                    android:id="@+id/etProveedor"
                    style="@style/FormInput"
                    android:layout_marginBottom="20dp"
                    android:hint="@string/placeholder_proveedor"
                    android:inputType="text|textCapWords" />

                <!-- Botones -->
                <Button
                    android:id="@+id/btnCrear"
                    style="@style/AppButton.Primary"
                    android:layout_width="match_parent"
                    android:text="@string/btn_crear" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnActualizar"
                        style="@style/AppButton.Outline"
                        android:layout_width="0dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/btn_actualizar" />

                    <Button
                        android:id="@+id/btnEliminar"
                        style="@style/AppButton.Danger"
                        android:layout_width="0dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="@string/btn_eliminar" />
                </LinearLayout>
            </LinearLayout>

            <!-- Inventario -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_inventario"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvContador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etBuscar"
                style="@style/FormInput"
                android:layout_marginBottom="14dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:drawableTint="@color/text_hint"
                android:hint="@string/hint_buscar"
                android:inputType="text" />

            <LinearLayout
                android:id="@+id/containerInventario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInventario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_cargando"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>